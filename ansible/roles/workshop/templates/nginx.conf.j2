# {{ ansible_managed }}
# nginx.conf IA'cking : HTTPS sur ports {{ student_port }} (élève) et {{ admin_port }} (admin).
# Cert auto-signé monté en lecture seule depuis {{ ssl_dir }} sur l'hôte.
# Ce fichier est MONTÉ par-dessus /etc/nginx/nginx.conf via la override compose
# (cf. docker-compose.override.yml) ; il ne remplace jamais le nginx.conf versionné.

worker_processes auto;
pid /var/run/nginx.pid;
events { worker_connections 1024; }

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    server_tokens off;
    client_max_body_size 64k;

    # --- TLS ---
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       1h;
    ssl_session_tickets       off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # Polices auto-hébergées (cf. frontend/public/fonts.css) : pas de domaine Google.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' wss:; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    access_log /var/log/nginx/access.log;
    error_log  /var/log/nginx/error.log warn;

    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    upstream backend_student { server backend:{{ student_port }}; }
    upstream backend_admin   { server backend:{{ admin_port }}; }

    # ============================================================
    # ÉLÈVE : port {{ student_port }} HTTPS
    # ============================================================
    server {
        listen {{ student_port }} ssl default_server;
        http2  on;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

        root /usr/share/nginx/html;

        location = /     { try_files /student.html =404; }
        location = /demo { try_files /demo.html    =404; }

        location ~ ^/static/(?<asset>[\w.\-]+\.(?:css|js|woff2?|ttf|svg|png|ico))$ {
            alias /usr/share/nginx/html/$asset;
            expires 1h;
            add_header Cache-Control "public, max-age=3600";
        }

        location = /api/ws {
            proxy_pass http://backend_student;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 600s;
        }

        location /api/ {
            proxy_pass http://backend_student;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 120s;
        }

        location = /health {
            proxy_pass http://backend_student/health;
            access_log off;
        }

        location / { return 404; }
    }

    # ============================================================
    # ADMIN : port {{ admin_port }} HTTPS
    # ============================================================
    server {
        listen {{ admin_port }} ssl default_server;
        http2  on;
        server_name _;

        ssl_certificate     /etc/nginx/ssl/server.crt;
        ssl_certificate_key /etc/nginx/ssl/server.key;

        root /usr/share/nginx/html;

        location = /           { try_files /admin.html      =404; }
        location = /scoreboard { try_files /scoreboard.html =404; }

        location ~ ^/static/(?<asset>[\w.\-]+\.(?:css|js|woff2?|ttf|svg|png|ico))$ {
            alias /usr/share/nginx/html/$asset;
            expires 1h;
        }

        location = /admin/ws/monitor {
            proxy_pass http://backend_admin;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 600s;
        }

        location /admin/ {
            proxy_pass http://backend_admin;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For  $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 120s;
        }

        location = /health {
            proxy_pass http://backend_admin/health;
            access_log off;
        }

        location / { return 404; }
    }
}

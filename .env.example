
# Clé API OpenRouter
OPENROUTER_API_KEY=sk-or-your_key_here

# URL de base OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Attribution OpenRouter
OPENROUTER_APP_TITLE=IA'cking
OPENROUTER_APP_URL=https://github.com/Kylian14/IA-cking

# Mot de passe pour le dashboard admin (port 8001).
ADMIN_PASSWORD=changeme

# Secret cookies
SESSION_SECRET=remplace_moi_par_une_longue_chaine_aleatoire

# Ports d'écoute
STUDENT_PORT=8000
ADMIN_PORT=8001

HOST=127.0.0.1

# Chemin du fichier SQLite.
# - En mode Docker, docker-compose force /app/data/workshop.db 
# - En dev local, laisse vide pour utiliser le défaut <projet>/data/workshop.db.
# DB_PATH=data/workshop.db

# Nombre maximum de paires (user, assistant) envoyées au modèle dans l'historique
HISTORY_MAX_PAIRS=10

# Passer à 1 en HTTPS
SECURE_COOKIES=0

# TTL des cookies de session -  24h par défaut.
COOKIE_TTL_SEC=86400

# Budget LLM 
MAX_LLM_CALLS_PER_SESSION=300

# Limite globale du payload JSON 
MAX_BODY_BYTES=65536

# Rate limits
LOGIN_RATE_LIMIT=5/minute
ADMIN_LOGIN_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute
VERIFY_RATE_LIMIT=5/minute

WS_ALLOWED_ORIGINS=
WS_MAX_PER_TOKEN=5
WS_IDLE_TIMEOUT_SEC=120

# DB : cap FIFO de messages par (token, niveau) pour éviter le ballooning.
MAX_MESSAGES_PER_LEVEL=500

# Niveau de log (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# {{ ansible_managed }}
# .env de l'atelier IA'cking, généré par Ansible.

# OpenRouter
OPENROUTER_API_KEY={{ vault_openrouter_api_key }}
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=IA'cking
OPENROUTER_APP_URL=https://github.com/Kylian14/IA-cking

# Auth
ADMIN_PASSWORD={{ vault_admin_password }}
SESSION_SECRET={{ effective_session_secret }}
SECURE_COOKIES=1
COOKIE_TTL_SEC={{ session_ttl_seconds }}

# Ports internes du backend (dans le container)
STUDENT_PORT={{ student_port }}
ADMIN_PORT={{ admin_port }}
HOST=0.0.0.0

# Ports hôte exposés par le frontend (interpolés par docker-compose.yml).
# 443 pour l'élève en HTTPS sur le LAN, {{ admin_port }} pour l'admin.
STUDENT_HOST_PORT={{ student_host_port }}
ADMIN_HOST_PORT={{ admin_port }}

# LLM / historique
HISTORY_MAX_PAIRS={{ history_max_pairs }}
MAX_LLM_CALLS_PER_SESSION={{ max_llm_calls_per_session }}
MAX_BODY_BYTES=65536

# Rate limits
LOGIN_RATE_LIMIT={{ login_rate_limit }}
ADMIN_LOGIN_RATE_LIMIT={{ admin_login_rate_limit }}
CHAT_RATE_LIMIT={{ chat_rate_limit }}
VERIFY_RATE_LIMIT={{ verify_rate_limit }}

# WebSocket
WS_ALLOWED_ORIGINS=
WS_MAX_PER_TOKEN=5
WS_IDLE_TIMEOUT_SEC=120

# Storage
MAX_MESSAGES_PER_LEVEL=500

LOG_LEVEL={{ log_level }}
